{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadExistingPublicBedfordImages",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion"],
      "Resource": "arn:aws:s3:::img.bedfordfineartgallery.com/*"
    },
    {
      "Sid": "DistinguishMissingBedfordImages",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::img.bedfordfineartgallery.com"
    },
    {
      "Sid": "WriteOnlyDerivedNicheThumbnails",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::img.bedfordfineartgallery.com/derived/niche-v1/*"
    }
  ]
}
